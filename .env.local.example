# Kopiera denna fil till .env.local och fyll i värdena från ditt Supabase-projekt
# (Project Settings → API). .env.local checkas aldrig in i git.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OBS: service_role-nyckeln ger full åtkomst förbi alla säkerhetsregler.
# Används bara i serverkod (admin-funktioner) och får ALDRIG committas
# eller exponeras till webbläsaren.
SUPABASE_SERVICE_ROLE_KEY=
